# Lodestar environment variables (optional; config/polaris.json is preferred)
# Copy to .env only if you need environment overrides.

LODESTAR_ONEBOT_URL=ws://127.0.0.1:6199/ws
LODESTAR_ONEBOT_TOKEN=replace-me
LODESTAR_SELF_ID=123456789

# SendGuard defaults
LODESTAR_GROUP_WHITELIST=123456789
LODESTAR_PRIVATE_ENABLED=0
LODESTAR_PRIVATE_WHITELIST=
LODESTAR_DAILY_QUOTA=200
LODESTAR_PER_GROUP_DAILY_QUOTA=80
LODESTAR_MIN_INTERVAL_MS=2000
LODESTAR_RANDOM_DELAY_MS=1500
LODESTAR_DUPLICATE_WINDOW_MS=60000
LODESTAR_SEND_FAILURE_THRESHOLD=3
LODESTAR_AUDIT_RETENTION_DAYS=30
LODESTAR_AT_ONLY=1
LODESTAR_STOP_FILE=data/STOP

# Optional HTTP surfaces
LODESTAR_HEALTH_PORT=18080
LODESTAR_CONTROL_PORT=18090
LODESTAR_ADMIN_TOKEN=replace-with-a-local-random-token

# Storage
LODESTAR_DB_PATH=data/polaris.db
LODESTAR_LOG_LEVEL=info
