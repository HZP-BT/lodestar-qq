# Linux runtime image for the Lodestar gateway (Core + Web panel + OneBot upstream adapter).
#
# The native NTQQ loader is Windows-only. On Linux Lodestar runs as a gateway in
# front of an external OneBot v11 upstream (NapCat/LagoneBot/LLOneBot on Linux)
# and exposes the reverse WebSocket that AstrBot connects to.

FROM node:24-bookworm-slim AS build

WORKDIR /app
RUN npm install -g pnpm@10.18.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY scripts ./scripts
COPY config ./config

RUN pnpm install --frozen-lockfile
RUN pnpm build
RUN pnpm exec esbuild scripts/upstream.mjs \
      --bundle --platform=node --format=cjs --target=node22 \
      --outfile=/app/lodestar.cjs --log-level=warning \
      --log-override:empty-import-meta=silent

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

RUN mkdir -p /app/config /app/data /app/logs

COPY --from=build /app/lodestar.cjs ./lodestar.cjs
COPY --from=build /app/packages/web/dist ./packages/web/dist
COPY --from=build /app/config/upstream.example.json ./config/upstream.example.json
COPY --from=build /app/LICENSE ./LICENSE

EXPOSE 18080 18081
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:18080/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "lodestar.cjs"]
